# Copy this file to .env and adjust values. Never commit the real .env file.

# PostgreSQL
POSTGRES_DB=hotel_pms
POSTGRES_USER=hotel_pms
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5433

# ASP.NET Core API
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=5080
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=hotel_pms;Username=hotel_pms;Password=change-me-locally

Jwt__Secret=change-me-to-a-long-random-string-in-every-environment
Jwt__Issuer=HotelPms
Jwt__Audience=HotelPmsClient
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

SeedData__DefaultPassword=ChangeMe123!

# Frontend
VITE_API_BASE_URL=http://localhost:5080/api/v1
FRONTEND_PORT=5173
